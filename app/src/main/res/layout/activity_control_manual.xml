<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvManualTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control Manual (HC-05)"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLastCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Último comando: Ninguno"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenBarrier"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="Abrir barrera (A)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseBarrier"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Cerrar barrera (O)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddVehicle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="Sumar vehículo (E)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubVehicle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Restar vehículo (U)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetCounter"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="Reiniciar contador (I)" />

    </LinearLayout>
</ScrollView>